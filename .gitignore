/.tools/
# PDF 文本抽取是可再生结果；工具脚本本身保留。
/LLM-tmp/04-工具/tech-full.txt
/.go-toolchain-temp
/LLM-tmp/服务端/*.exe
/LLM-tmp/服务端/*-test*.json
**/.godot/
/LLM-tmp/服务端/server.exe
/LLM-tmp/服务端/bin/
/LLM-tmp/服务端/data/*.json
/LLM-tmp/服务端/LLM-tmp/
/LLM-tmp/服务端/*.out.log
/LLM-tmp/服务端/*.err.log
# Godot 的 .uid 是资源身份元数据，应和对应脚本一起入库。
/LLM-tmp/.review/
/LLM-tmp/交付/
# 保留当前完整可玩包（88.60 MiB）；其他导出和解压副本不入库。
/dist/*
!/dist/.gitkeep
!/dist/README.md
!/dist/檐下千秋-v10-可玩性修复版-20260915.zip
!/dist/檐下千秋-v10-可玩性修复版-20260915.zip.sha256

# AI 配音：184 段 wav 的正式位置是
#   LLM-tmp/客户端/assets/voice/       —— 游戏运行时读取
#   Art_Material/Generation/生成音频/  —— 素材溯源
# 本目录不再保留副本；需要时用 工具/generate_voice.py + 工具/speakers.json 重新生成。
/AI配音台词/生成音频/
/AI配音台词/试听/
/AI配音台词/*.zip
/tmp/

# 正式展开材料完整保留；约 674 MiB 的总提交包只在本地交付。
# Gitignore 不能按大小过滤；提交前运行 tools/check_git_size.py。
/output/参赛材料/*.zip
/output/参赛材料/*.zip.part
/output/参赛材料/*/Task03/Final/*_核心可玩实体/Windows-x64/*.exe
/output/参赛材料/*/Task03/Final/*_核心可玩实体/Windows-x64/server/*.exe

# Python/Godot 缓存及 Office 锁文件，不忽略测试日志、AI 记录或素材。
__pycache__/
*.py[cod]
~$*
.DS_Store
Thumbs.db
